# Offline demo environment — copy to apps/web/.env.local (add your Clerk keys)
# Local Postgres (docker run -d --name unisphere-pg -e POSTGRES_PASSWORD=shu -p 5433:5432 postgres:16)

DATABASE_URL="postgresql://postgres:shu@localhost:5433/unisphere"
DIRECT_URL="postgresql://postgres:shu@localhost:5433/unisphere"

# Clerk — paste the real keys from the team password manager
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_... (paste)"
CLERK_SECRET_KEY="sk_test_... (paste)"
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# AI — intentionally omitted; the assistant answers from the knowledge base via
# the canned fallback. Set GROQ_API_KEY to enable full answers when online.
