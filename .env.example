# ── Database (Neon Postgres) ─────────────────────────────────────────────
# Pooled connection string — used by the app at runtime (Vercel serverless).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct (non-pooled) connection string — used by Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ── Clerk (apps/web) ─────────────────────────────────────────────────────
# Get these with `clerk env pull` (writes apps/web/.env.local) or from the
# Clerk dashboard. The public key must be exposed to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ── AI assistant (M5) — OpenAI-compatible provider, Groq by default ─────
# Create a free key at https://console.groq.com → API Keys.
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_API_KEY="gsk_..."
AI_MODEL="llama-3.3-70b-versatile"
# 1 = always answer from the canned knowledge base (no provider calls).
AI_FALLBACK_MODE="0"
