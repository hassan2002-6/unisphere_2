# ── Database (Neon Postgres) ─────────────────────────────────────────────
# Pooled connection string — used by the app at runtime (Vercel serverless).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct (non-pooled) connection string — used by Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ── Clerk (apps/web) ─────────────────────────────────────────────────────
# Get these with `clerk env pull` (writes apps/web/.env.local) or from the
# Clerk dashboard. The public key must be exposed to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# From the Clerk dashboard → Webhooks → endpoint → Signing Secret.
CLERK_WEBHOOK_SECRET="whsec_..."
# Set to "false" to stop auto-creating STUDENT rows for unknown sign-ins
# (portal then shows "not provisioned" until an admin adds the user).
AUTO_PROVISION="false"

# ── AI assistant (M5) ────────────────────────────────────────────────────
# CommandCode is the project default (OpenAI-compatible). Paste your key:
# https://commandcode.ai/ → API key. Model ids: deepseek/deepseek-v4.1-flash (default),
# deepseek/deepseek-v4-pro, claude-sonnet-5, …
COMMANDCODE_API_KEY=""
# AI_MODEL="deepseek/deepseek-v4.1-flash"
# COMMANDCODE_BASE_URL="https://api.commandcode.ai/provider/v1"
#
# Alternatives (first configured wins: CommandCode → Groq → OpenAI → OpenRouter → custom):
# GROQ_API_KEY="gsk_..."            # free tier — https://console.groq.com
# OPENAI_API_KEY="sk-..."
# OPENROUTER_API_KEY="sk-or-..."
# AI_API_KEY="" + AI_BASE_URL=""    # any OpenAI-compatible endpoint
#
# 1 = always answer from the canned knowledge base (no provider calls).
AI_FALLBACK_MODE="0"

# Absolute origin used in invitation + recovery links
NEXT_PUBLIC_APP_URL="http://localhost:3000"
