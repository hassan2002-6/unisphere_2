// UniSphere — data model (plan §6.1). Neon Postgres via driver adapter.
// CLI connection URL comes from prisma7.config.ts (DIRECT_URL preferred).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────
enum Role {
  STUDENT
  FACULTY
  COORDINATOR
  FYP_HEAD
  MENTOR
  ADMIN
}

enum FormStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum FypStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ResourceRequestStatus {
  PENDING
  RECOMMENDED
  ALLOCATED
  REJECTED
  CANCELLED
}

enum AllocationStatus {
  ACTIVE
  COMPLETED
  REVOKED
}

enum MentorshipRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum MentorshipSessionStatus {
  PROPOSED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum InternshipApplicationStatus {
  APPLIED
  SHORTLISTED
  ACCEPTED
  REJECTED
}

enum ResourceType {
  GPU
  CPU
  WORKSTATION
  LAB
}

enum NotificationType {
  FORM
  COMPLAINT
  FYP
  RESOURCE
  MENTORSHIP
  INTERNSHIP
  ANNOUNCEMENT
  SYSTEM
  MESSAGE
  CLASH
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

// ── Identity ─────────────────────────────────────────────────────────────
model User {
  id             String   @id @default(cuid())
  clerkId        String   @unique
  email          String   @unique
  name           String
  role           Role     @default(STUDENT)
  department     String?
  registrationNo String?
  employeeId     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  studentProfile StudentProfile?
  facultyProfile FacultyProfile?
  mentorProfile  MentorProfile?

  formSubmissions        FormSubmission[]        @relation("FormSubmitter")
  formReviews            FormSubmission[]        @relation("FormReviewer")
  formEvents             FormEvent[]             @relation("FormEventActor")
  complaints             Complaint[]             @relation("ComplaintSubmitter")
  assignedComplaints     Complaint[]             @relation("ComplaintAssignee")
  complaintEvents        ComplaintEvent[]        @relation("ComplaintEventActor")
  fypApplications        FypApplication[]        @relation("FypApplicant")
  fypDecisions           FypApplication[]        @relation("FypDecider")
  fypSupervised          FypApplication[]        @relation("FypSupervisor")
  resourceRequests       ResourceRequest[]       @relation("RequestApplicant")
  resourceDecisions      ResourceRequest[]       @relation("RequestDecider")
  allocations            Allocation[]            @relation("AllocationActor")
  internshipsPosted      Internship[]            @relation("InternshipPoster")
  internshipApplications InternshipApplication[] @relation("InternshipApplicant")
  mentorshipAsStudent    MentorshipRequest[]     @relation("MentorshipStudent")
  mentorshipAsMentor     MentorshipRequest[]     @relation("MentorshipMentor")
  sessionsProposed       MentorshipSession[]     @relation("SessionProposer")
  chatSessions           ChatSession[]
  notifications          Notification[]
  classes                CourseClass[]           @relation("ClassFaculty")
  clashResolutions       ClashResolution[]       @relation("ClashResolver")
  attendanceMarked       AttendanceRecord[]      @relation("AttendanceMarker")
  attendance             AttendanceRecord[]      @relation("AttendanceStudent")
  assessmentsCreated     Assessment[]            @relation("AssessmentCreator")
  assessmentScores       Score[]                 @relation("ScoreStudent")
  scoresEntered          Score[]                 @relation("ScoreEnterer")
  courseResults          CourseResult[]          @relation("ResultStudent")
  resultsPublished       CourseResult[]          @relation("ResultPublisher")
  messagesSent           Message[]               @relation("MessageSender")
  messagesReceived       Message[]               @relation("MessageRecipient")
  enrollments            Enrollment[]            @relation("EnrollmentStudent")
  auditLogs              AuditLog[]              @relation("AuditActor")
  clashReports           ClashReport[]           @relation("ClashReporter")
  clashReportsHandled    ClashReport[]           @relation("ClashHandler")
  fypProgressNotes       FypProgressUpdate[]     @relation("FypProgressAuthor")
}

model StudentProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  semester Int?
  batch    String?
  section  String?
  program  String  @default("BSCS")
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FacultyProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  designation String?
  office      String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MentorProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  headline         String
  company          String?
  expertise        String[]
  bio              String?
  linkedinUrl      String?
  isApproved       Boolean  @default(false)
  maxActiveMentees Int      @default(5)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Schedule ─────────────────────────────────────────────────────────────
model CourseClass {
  id         String          @id @default(cuid())
  courseCode String
  title      String
  section    String
  department String
  semester   String
  credits    Int?
  facultyId  String?
  faculty    User?           @relation("ClassFaculty", fields: [facultyId], references: [id])
  slots      TimetableSlot[]
  exams      ExamSchedule[]
  enrollments Enrollment[]
  attendance AttendanceRecord[]
  assessments Assessment[]
  results    CourseResult[]

  @@index([courseCode, section])
}

// Student ↔ course roster (the "Enrollments" table from the report).
model Enrollment {
  id         String      @id @default(cuid())
  studentId  String
  classId    String
  status     String      @default("ACTIVE") // ACTIVE | COMPLETED | DROPPED
  enrolledAt DateTime    @default(now())
  student    User        @relation("EnrollmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  class      CourseClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([classId])
}

model TimetableSlot {
  id       String      @id @default(cuid())
  classId  String
  day      DayOfWeek
  startMin Int
  endMin   Int
  room     String?
  labId    String?
  class    CourseClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  lab      Lab?        @relation("LabSlots", fields: [labId], references: [id])

  @@index([day, startMin, endMin])
}

model ExamSchedule {
  id          String       @id @default(cuid())
  classId     String?
  courseTitle String
  date        DateTime
  startMin    Int
  endMin      Int
  hall        String?
  class       CourseClass? @relation(fields: [classId], references: [id])

  @@index([date])
}

model Lab {
  id          String          @id @default(cuid())
  name        String
  number      String
  capacity    Int
  type        String?
  slots       TimetableSlot[] @relation("LabSlots")
  allocations Allocation[]
}

model Resource {
  id          String       @id @default(cuid())
  name        String
  model       String
  type        ResourceType
  specs       String
  quantity    Int
  available   Int
  allocations Allocation[]
}

// ── Notifications ────────────────────────────────────────────────────────
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ── Forms Center ─────────────────────────────────────────────────────────
model FormTemplate {
  id             String           @id @default(cuid())
  key            String           @unique
  title          String
  description    String
  audienceRole   Role
  reviewerRole   Role
  recipientLabel String
  fields         Json
  active         Boolean          @default(true)
  slaDays        Int?
  submissions    FormSubmission[]
}

model FormSubmission {
  id            String       @id @default(cuid())
  templateId    String
  submittedById String
  payload       Json
  status        FormStatus   @default(SUBMITTED)
  reviewerId    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  template      FormTemplate @relation(fields: [templateId], references: [id])
  submittedBy   User         @relation("FormSubmitter", fields: [submittedById], references: [id])
  reviewer      User?        @relation("FormReviewer", fields: [reviewerId], references: [id])
  events        FormEvent[]

  @@index([status])
  @@index([submittedById])
}

model FormEvent {
  id           String         @id @default(cuid())
  submissionId String
  actorId      String?
  fromStatus   FormStatus?
  toStatus     FormStatus
  comment      String?
  createdAt    DateTime       @default(now())
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor        User?          @relation("FormEventActor", fields: [actorId], references: [id])
}

// ── Complaints ───────────────────────────────────────────────────────────
model Complaint {
  id            String           @id @default(cuid())
  submittedById String
  subject       String
  category      String
  description   String
  status        ComplaintStatus  @default(OPEN)
  assignedToId  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  submittedBy   User             @relation("ComplaintSubmitter", fields: [submittedById], references: [id])
  assignedTo    User?            @relation("ComplaintAssignee", fields: [assignedToId], references: [id])
  events        ComplaintEvent[]

  @@index([status])
  @@index([submittedById])
}

model ComplaintEvent {
  id          String          @id @default(cuid())
  complaintId String
  actorId     String?
  status      ComplaintStatus
  comment     String?
  createdAt   DateTime        @default(now())
  complaint   Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actor       User?           @relation("ComplaintEventActor", fields: [actorId], references: [id])
}

// ── Internships ──────────────────────────────────────────────────────────
model Internship {
  id           String                  @id @default(cuid())
  title        String
  company      String
  description  String
  location     String?
  mode         String?
  stipend      String?
  deadline     DateTime?
  applyUrl     String?
  tags         String[]
  status       String                  @default("OPEN")
  postedById   String
  createdAt    DateTime                @default(now())
  postedBy     User                    @relation("InternshipPoster", fields: [postedById], references: [id])
  applications InternshipApplication[]
}

model InternshipApplication {
  id           String                      @id @default(cuid())
  internshipId String
  studentId    String
  note         String?
  status       InternshipApplicationStatus @default(APPLIED)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  internship   Internship                  @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  student      User                        @relation("InternshipApplicant", fields: [studentId], references: [id])

  @@unique([internshipId, studentId])
  @@index([status])
}

// ── FYP ──────────────────────────────────────────────────────────────────
model FypApplication {
  id              String    @id @default(cuid())
  applicantId     String
  title           String
  domain          String
  description     String
  technologies    String
  groupName       String
  members         String
  registrationNos String
  supervisorPref  String?
  department      String
  semester        String
  status          FypStatus @default(PENDING)
  remarks         String?
  decidedById     String?
  decidedAt       DateTime?
  supervisorId    String?
  createdAt       DateTime  @default(now())
  applicant       User      @relation("FypApplicant", fields: [applicantId], references: [id])
  decidedBy       User?     @relation("FypDecider", fields: [decidedById], references: [id])
  supervisor      User?     @relation("FypSupervisor", fields: [supervisorId], references: [id])
  progressUpdates FypProgressUpdate[]

  @@index([status])
  @@index([applicantId])
  @@index([supervisorId])
}

/** Supervisor ↔ group progress log (spec §12: review progress, add remarks). */
model FypProgressUpdate {
  id            String         @id @default(cuid())
  applicationId String
  authorId      String
  note          String
  createdAt     DateTime       @default(now())
  application   FypApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author        User           @relation("FypProgressAuthor", fields: [authorId], references: [id])

  @@index([applicationId])
}

// ── Resources / GPU workflow ─────────────────────────────────────────────
model ResourceRequest {
  id           String                @id @default(cuid())
  applicantId  String
  projectName  String
  groupName    String
  members      String
  supervisor   String?
  resourceType ResourceType
  config       String
  purpose      String
  startDate    DateTime
  endDate      DateTime
  timeSlot     String
  status       ResourceRequestStatus @default(PENDING)
  remarks      String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime              @default(now())
  applicant    User                  @relation("RequestApplicant", fields: [applicantId], references: [id])
  decidedBy    User?                 @relation("RequestDecider", fields: [decidedById], references: [id])
  allocation   Allocation?

  @@index([status])
  @@index([applicantId])
}

model Allocation {
  id            String           @id @default(cuid())
  requestId     String           @unique
  resourceId    String
  labId         String?
  startDate     DateTime
  endDate       DateTime
  timeSlot      String
  status        AllocationStatus @default(ACTIVE)
  allocatedById String
  allocatedAt   DateTime         @default(now())
  notes         String?
  request       ResourceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  resource      Resource         @relation(fields: [resourceId], references: [id])
  lab           Lab?             @relation(fields: [labId], references: [id])
  allocatedBy   User             @relation("AllocationActor", fields: [allocatedById], references: [id])

  @@index([status])
}

// ── Mentorship ───────────────────────────────────────────────────────────
model MentorshipRequest {
  id        String                  @id @default(cuid())
  studentId String
  mentorId  String
  message   String
  status    MentorshipRequestStatus @default(PENDING)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  student   User                    @relation("MentorshipStudent", fields: [studentId], references: [id])
  mentor    User                    @relation("MentorshipMentor", fields: [mentorId], references: [id])
  sessions  MentorshipSession[]

  @@index([mentorId, status])
  @@index([studentId, status])
}

model MentorshipSession {
  id           String                  @id @default(cuid())
  requestId    String
  proposedById String
  scheduledAt  DateTime
  mode         String
  location     String?
  notes        String?
  status       MentorshipSessionStatus @default(PROPOSED)
  createdAt    DateTime                @default(now())
  request      MentorshipRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  proposedBy   User                    @relation("SessionProposer", fields: [proposedById], references: [id])

  @@index([status])
}

// ── AI assistant ─────────────────────────────────────────────────────────
model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
}

model ChatMessage {
  id         String      @id @default(cuid())
  sessionId  String
  role       String
  content    String
  sources    Json?
  tokenCount Int?
  createdAt  DateTime    @default(now())
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model KnowledgeDoc {
  id        String   @id @default(cuid())
  title     String
  source    String
  content   String
  tags      String[]
  updatedAt DateTime @updatedAt
}

// Academic planning: BSCS degree plan (8 semesters) — seeded, shown in /planning.
model DegreePlanCourse {
  id         String  @id @default(cuid())
  program    String
  semester   Int
  courseCode String
  title      String
  credits    Int
  category   String?
  prereq     String?

  @@unique([program, semester, courseCode])
}

// Coordinator acknowledgement that a computed clash has been dealt with.
// Clashes themselves are computed live (deterministic keys) — this only
// records resolution notes, per plan §11 2a ("approximate resolution").
model ClashResolution {
  id           String   @id @default(cuid())
  key          String   @unique
  note         String?
  resolvedById String
  resolvedAt   DateTime @default(now())
  resolvedBy   User     @relation("ClashResolver", fields: [resolvedById], references: [id])
}

// ── Attendance ───────────────────────────────────────────────────────────
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  studentId    String
  classId      String
  date         DateTime
  status       AttendanceStatus
  markedById   String?
  markedAt     DateTime         @default(now())
  note         String?
  student      User             @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  class        CourseClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  markedBy     User?            @relation("AttendanceMarker", fields: [markedById], references: [id])

  @@unique([studentId, classId, date])
  @@index([classId, date])
  @@index([studentId])
}

// ── Marks / Results ──────────────────────────────────────────────────────
enum AssessmentKind {
  QUIZ
  ASSIGNMENT
  MIDTERM
  FINAL
  PROJECT
}

model Assessment {
  id          String         @id @default(cuid())
  classId     String
  kind        AssessmentKind
  title       String
  maxMarks    Int
  date        DateTime?
  createdById String?
  createdAt   DateTime       @default(now())
  class       CourseClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation("AssessmentCreator", fields: [createdById], references: [id])
  scores      Score[]

  @@index([classId])
}

model Score {
  id           String     @id @default(cuid())
  assessmentId String
  studentId    String
  marks        Int?
  remarks      String?
  enteredById  String?
  updatedAt    DateTime   @updatedAt
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student      User       @relation("ScoreStudent", fields: [studentId], references: [id], onDelete: Cascade)
  enteredBy    User?      @relation("ScoreEnterer", fields: [enteredById], references: [id])

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

model CourseResult {
  id              String      @id @default(cuid())
  studentId       String
  classId         String
  totalMarks      Int?
  grade           String?
  gradePoints     Float?
  published       Boolean     @default(false)
  publishedAt     DateTime?
  publishedById   String?
  updatedAt       DateTime    @updatedAt
  student         User        @relation("ResultStudent", fields: [studentId], references: [id], onDelete: Cascade)
  class           CourseClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  publishedBy     User?       @relation("ResultPublisher", fields: [publishedById], references: [id])

  @@unique([studentId, classId])
  @@index([studentId])
}

// ── Internal messaging ───────────────────────────────────────────────────
model Message {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  subject     String?
  body        String
  readAt      DateTime?
  createdAt   DateTime @default(now())
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([senderId])
}

// ── Audit trail ──────────────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  summary   String?
  meta      Json?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ── Student-reported clashes (timetable / exam) ──────────────────────────
enum ClashReportKind {
  TIMETABLE
  EXAM
}

enum ClashReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model ClashReport {
  id             String            @id @default(cuid())
  reportedById   String
  kind           ClashReportKind
  description    String
  classId        String?
  otherClassId   String?
  examId         String?
  status         ClashReportStatus @default(OPEN)
  resolutionNote String?
  handledById    String?
  handledAt      DateTime?
  createdAt      DateTime          @default(now())
  reportedBy     User              @relation("ClashReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  handledBy      User?             @relation("ClashHandler", fields: [handledById], references: [id])

  @@index([status])
  @@index([reportedById])
}
